# ==============================================================
# Option 1: GAS Web App (完全無料・サーバーレス運用の場合)
# ==============================================================
# Google Apps Script で「Web アプリ」としてデプロイした URL を指定します。
# NEXT_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/AKfycbx.../exec

# ==============================================================
# Option 2: FastAPI バックエンド (Python サーバー運用の場合)
# ==============================================================
# ローカル開発環境:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Cloud Run 等にデプロイした場合:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-service.run.app
