# 国土数値情報のメタデータ取得元
KSJ_METADATA_SOURCE_URL=https://nlftp.mlit.go.jp/ksj/
KSJ_DETAIL_BASE_URL=https://nlftp.mlit.go.jp/ksj/gml/datalist/
METADATA_OUTPUT_PATH=backend/app/data/metadata.json
# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Drive API
# サービスアカウントJSON、またはユーザーOAuth認証JSONのローカルパス。
# JSON自体はコミットしないでください。
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_METADATA_FILENAME=metadata.json

# Google Workspaceのドメイン全体の委任を使う場合のみ指定します。
GOOGLE_DRIVE_IMPERSONATE_USER=
